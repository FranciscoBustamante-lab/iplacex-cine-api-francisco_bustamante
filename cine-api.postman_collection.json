{
  "info": {
    "name": "Cine IPLACEX API REST",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden. Crea un actor de prueba que permanece en la base; la pauta no contempla DELETE de actores. La eliminación solo afecta la película creada por esta colección."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "peliculaId",
      "value": ""
    },
    {
      "key": "peliculaNombre",
      "value": ""
    },
    {
      "key": "actorId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Bienvenida",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Crear película de prueba",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/pelicula",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Prueba Postman {{$guid}}\",\n  \"generos\": [\n    \"Drama\"\n  ],\n  \"anioEstreno\": 2024\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { const data = pm.response.json(); pm.collectionVariables.set('peliculaId', data._id); pm.collectionVariables.set('peliculaNombre', data.nombre); }"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Listar películas",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/peliculas"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Consultar película",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/pelicula/{{peliculaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Crear actor por nombre de película",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/actor",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombrePelicula\": \"{{peliculaNombre}}\",\n  \"nombre\": \"Actor Postman\",\n  \"edad\": 30,\n  \"estaRetirado\": false,\n  \"premios\": []\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('actorId', pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Listar actores",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/actores"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Consultar actor",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/actor/{{actorId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Actores de la película",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/actor/pelicula/{{peliculaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Actualizar película",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/pelicula/{{peliculaId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Película actualizada desde Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Verificar actualización",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/pelicula/{{peliculaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));",
              "pm.test('Nombre actualizado', () => pm.expect(pm.response.json().nombre).to.eql('Película actualizada desde Postman'));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 ID inválido",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/pelicula/invalido"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Película inexistente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/pelicula/000000000000000000000000"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Año inválido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/pelicula",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Inválida\",\n  \"generos\": [],\n  \"anioEstreno\": \"2024abc\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Actor sin película existente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/actor",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombrePelicula\": \"Inexistente {{$guid}}\",\n  \"nombre\": \"Actor\",\n  \"edad\": 30,\n  \"estaRetirado\": false,\n  \"premios\": []\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Eliminar SOLO película de prueba",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/pelicula/{{peliculaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 Confirmar eliminación",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/pelicula/{{peliculaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
